---
import { competition } from '../data/competition';
import '../styles/global.css';

const c = competition;

// With no external registration URL yet, CTAs point at the registration section.
const registrationHref = c.registrationUrl ?? '#registration';

const infoItems = [
  { label: 'Date', value: c.date },
  { label: 'Time', value: c.time },
  { label: 'Location', value: c.location },
  { label: 'Eligibility', value: c.eligibility },
  { label: 'Registration deadline', value: c.registrationDeadline },
  { label: 'Requirements', value: c.requirements },
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.name}</title>
    <meta name="description" content={c.tagline} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL('/', Astro.site).href} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main">
      <header class="hero">
        <div class="wrap">
          <h1>{c.name}</h1>
          <p class="tagline">{c.tagline}</p>
          <p class="hero-meta">{c.date} · {c.location}</p>
          <a class="button" href={registrationHref}>Register</a>
        </div>
      </header>

      <section aria-labelledby="about-heading">
        <div class="wrap">
          <h2 class="section-title" id="about-heading">About</h2>
          <p>{c.about.purpose}</p>
          <ul class="objectives">
            {c.about.objectives.map((objective) => <li>{objective}</li>)}
          </ul>
        </div>
      </section>

      <section aria-labelledby="categories-heading">
        <div class="wrap">
          <h2 class="section-title" id="categories-heading">Categories</h2>
          <ul class="card-list">
            {
              c.categories.map((category) => (
                <li class="card">
                  <h3>{category.name}</h3>
                  <p>{category.description}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section aria-labelledby="info-heading">
        <div class="wrap">
          <h2 class="section-title" id="info-heading">Important information</h2>
          <dl class="info-list">
            {
              infoItems.map(({ label, value }) => (
                <>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </>
              ))
            }
          </dl>
        </div>
      </section>

      <section id="registration" aria-labelledby="registration-heading">
        <div class="wrap">
          <h2 class="section-title" id="registration-heading">Registration</h2>
          {
            c.registrationUrl ? (
              <>
                <p>Register before the deadline: {c.registrationDeadline}</p>
                <a class="button" href={c.registrationUrl}>Register now</a>
              </>
            ) : (
              <p class="note">
                Registration details will be announced. Check back soon, or
                contact us below.
              </p>
            )
          }
        </div>
      </section>

      <section aria-labelledby="contact-heading">
        <div class="wrap">
          <h2 class="section-title" id="contact-heading">Contact</h2>
          <p>Email: {c.contact.email}</p>
          {
            c.contact.socialLinks.length > 0 && (
              <ul class="objectives">
                {c.contact.socialLinks.map(({ label, url }) => (
                  <li>
                    <a href={url}>{label}</a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          {c.name} · <a href="https://imancorner.org">imancorner.org</a>
        </p>
      </div>
    </footer>
  </body>
</html>
